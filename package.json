{
  "name": "akik-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "budget": "bun scripts/check-bundle.ts",
    "build": "vp build && tsc -b",
    "ci:build": "vp run lint && tsc -b && vp test --run --coverage && vp build && bun scripts/check-bundle.ts",
    "clean": "rm -rf dist",
    "dev": "vp dev",
    "doctor": "react-doctor . --scope changed",
    "format": "vp fmt",
    "images": "bun scripts/optimise-images.ts",
    "lint": "vp lint --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "vp lint --fix",
    "placeholders": "bun scripts/placeholder-report.ts",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path",
    "start": "vp preview",
    "stryker": "stryker run",
    "stryker:incremental": "stryker run --incremental",
    "test": "vp test",
    "test:browser": "vp exec vitest --config vitest.browser.config.ts --run",
    "test:browser:install": "vp exec playwright install chromium",
    "test:coverage": "vp test --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "cn": "0.4.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.2",
    "oxc-transform-react": "0.153.0",
    "playwright": "^1.64.0",
    "react-doctor": "^0.9.18",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "wrangler": "^4.149.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.2"
}
